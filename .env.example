# Copy to /etc/glm53-tp2.env on the head. Never commit the real file.
HEAD_HOST=192.0.2.10
WORKER_HOST=192.0.2.11
SSH_USER=your-user

# The direct 100 GbE link. Both nodes use the same interface and subnet here.
FABRIC_IFACE=enp1s0f0np0
FABRIC_HCA=rocep1s0f0
FABRIC_CIDR=10.20.20.0/24
HEAD_FABRIC_IP=10.20.20.2
WORKER_FABRIC_IP=10.20.20.3

PORT=8000
MASTER_PORT=29521
CONTAINER_NAME=vllm_glm53

# Pin by digest. The reference fleet currently uses a local build of the same
# SM121/DFlash2 stack; see docs/image-provenance.md before changing this.
IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6

MODEL_HOST_PATH=/var/tmp/models/GLM-5.3-Flash-NVFP4
DRAFT_HOST_PATH=/var/tmp/models/GLM-5.3-Flash-DFlash2
NCCL_HOST_PATH=/opt/nccl-patched
NCCL_SHA256=ccd57342449c3f680befcb379329b935746e5299dc4de5f2516146e0411bd85f
RUNTIME_DIR=/var/lib/glm53-tp2

# Current cold-boot-proven settings. Raise KV only after the long-context gate.
KV_CACHE_BYTES=4294967296
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.82

# DFlash2 verifies k=3 or k=5 per request from an acceptance EMA. Set
# ADAPTIVE_K=0 for a fixed SPEC_TOKENS control run.
SPEC_TOKENS=5
ADAPTIVE_K=1
